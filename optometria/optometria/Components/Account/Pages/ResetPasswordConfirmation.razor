@page "/Account/ResetPasswordConfirmation"

<PageTitle>Clave actualizada</PageTitle>

<div class="auth-shell">
    <section class="auth-card text-center">
        <span class="auth-kicker">Contraseña</span>
        <h1>Clave actualizada</h1>
        <p role="alert">
            La contraseña fue restablecida correctamente.
        </p>
        <a class="btn btn-primary mt-3" href="Account/Login">Ir al inicio de sesión</a>
    </section>
</div>
