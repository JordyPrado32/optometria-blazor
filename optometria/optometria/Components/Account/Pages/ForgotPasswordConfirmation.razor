@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Correo enviado</PageTitle>

<div class="auth-shell">
    <section class="auth-card text-center">
        <span class="auth-kicker">Recuperación</span>
        <h1>Revisa tu correo</h1>
        <p role="alert">
            Si la cuenta existe, te enviamos instrucciones para restablecer la contraseña.
        </p>
        <a class="btn btn-outline-primary mt-3" href="/Account/Login">Volver al inicio de sesión</a>
    </section>
</div>
